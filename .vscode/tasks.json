{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Sikax : lancer",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["main.py"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Sikax : tests",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "pytest"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Sikax : vérifier l'installation",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["main.py", "--autotest"],
            "problemMatcher": []
        },
        {
            "label": "Sikax : fabriquer la distribution Windows",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "packaging/build_windows.ps1"],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
