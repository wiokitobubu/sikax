{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Sikax",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Sikax (thème clair)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--theme", "clair"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Sikax (exemple bielle-manivelle)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["${workspaceFolder}/resources/exemples/bielle_manivelle.sikax"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Tests (fichier courant)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-q"],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
